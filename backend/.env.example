# Copy this file to .env and edit locally. Never commit the real .env.
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_TIMEOUT_SECONDS=10
CACHE_TTL_SEASONS_SECONDS=3600
CACHE_TTL_RESULTS_SECONDS=86400
OPENF1_BATCH_PAUSE_SECONDS=2.1
CACHE_TTL_STANDINGS_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:5173
